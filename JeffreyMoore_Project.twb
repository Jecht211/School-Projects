      <column caption='Area Code' datatype='string' name='[AreaCode]' role='dimension' semantic-role='[AreaCode].[Name]' type='nominal' />
      <column datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([YearlySalesGoal]), -2, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Percent of Sales goal' datatype='real' name='[Calculation_1136089826205696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2797999449751557]/[YearlySalesGoal]' />
      </column>
      <column caption='Sales-profit' datatype='real' name='[Calculation_1136089835610113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2797999449751557]-[Profit Total (copy)_2882937036922881]' />
      </column>
      <column caption='First Purchase' datatype='real' name='[Calculation_1136090082295816]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [CustomerName] : SUM(IF [OrderDate] = { FIXED [CustomerName] : MIN([OrderDate]) } THEN [Calculation_2797999449751557] END) }' />
      </column>
      <column caption='First Purchase check' datatype='boolean' name='[Calculation_1136090085478409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[OrderDate] = { FIXED [CustomerName] : MIN([OrderDate]) }' />
      </column>
      <column caption='Sales Team filter' datatype='boolean' name='[Calculation_1136090103664650]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;All&quot; THEN TRUE&#13;&#10;ELSEIF [SalesTeam] = [Parameters].[Parameter 1] THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='Quarterly Goals' datatype='real' name='[Calculation_1136090115338253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[YearlySalesGoal]/4' />
      </column>
      <column caption='Sales Team filter: single line' datatype='string' name='[Calculation_1136090159317008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;All&apos; THEN &apos;Total Sales&apos;&#13;&#10;ELSE [SalesTeam]&#13;&#10;END' />
      </column>
      <column caption='Total Sales for Parameter' datatype='real' name='[Calculation_1136090161188881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;All&apos; &#13;&#10;THEN &#13;&#10;    // Combines ALL data into a single corporate-wide value&#13;&#10;    { FIXED : SUM([Calculation_2797999449751557]) }&#13;&#10;ELSE &#13;&#10;    // Logic for single selection: Selected team minus everything else&#13;&#10;    { FIXED : SUM(IF [SalesTeam] = [Parameters].[Parameter 1] THEN [Calculation_2797999449751557] ELSE 0 END) } &#13;&#10;    - &#13;&#10;    { FIXED : SUM(IF [SalesTeam] &lt;&gt; [Parameters].[Parameter 1] THEN [Calculation_2797999449751557] ELSE 0 END) }&#13;&#10;END' />
      </column>
      <column caption='Year Filter' datatype='boolean' name='[Calculation_1136090204852243]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;All&quot; OR STR(YEAR([OrderDate])) = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Profit Per Unit' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_1136090256994324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit Total (copy)_2882937036922881]/[OrderQuantity]' />
      </column>
      <column caption='Percent Sales Profit' datatype='real' default-format='p0%' name='[Calculation_1938731501481984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit Total (copy)_2882937036922881])/SUM([Calculation_2797999449751557])' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_2797999406469120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([UnitPrice])-AVG([UnitCost])-(AVG([DiscountApplied])*AVG([UnitPrice]))' />
      </column>
      <column caption='Yearly Profit' datatype='real' name='[Calculation_2797999409659906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([UnitPrice]-[UnitCost])*([DiscountApplied]/1)' />
      </column>
      <column caption='Cost Discounted' datatype='real' name='[Calculation_2797999411265539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([DiscountApplied])*AVG([UnitPrice])' />
      </column>
      <column caption='Total Sales' datatype='real' name='[Calculation_2797999449751557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[UnitPrice]*[OrderQuantity]' />
      </column>
      <column caption='Turnaround Time' datatype='integer' name='[Calculation_2882937025523712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [OrderDate], [ShipDate])' />
      </column>
      <column caption='Sales per 1000 Population' datatype='real' name='[Calculation_2882937039937538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2797999449751557])/(AVG([Population]))*1000' />
      </column>
      <column caption='Rounded Discount Applied' datatype='real' default-format='p0%' name='[Calculation_2882937059475460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Round([DiscountApplied], 2)' />
      </column>
      <column caption='Percent Profit' datatype='real' default-format='p0%' name='[Calculation_2882937061138437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([UnitPrice]*(1-([DiscountApplied]/100))-[UnitCost]))/[UnitPrice]' />
      </column>
      <column caption='Percent Profit from sales' datatype='real' default-format='p0%' name='[Calculation_2882937064595462]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([UnitPrice]*(1-[DiscountApplied]))-[UnitCost])/[UnitPrice]' />
      </column>
