      <datasource-dependencies datasource='federated.0clidmr03wbl6p184uec81hui52h'>
        <column datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='WINDOW_AVG(SUM([YearlySalesGoal]), -2, 0)'>
            <table-calc ordering-type='Rows' />
          </calculation>
        </column>
        <column caption='Quarterly Goals' datatype='real' name='[Calculation_1136090115338253]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[YearlySalesGoal]/4' />
        </column>
        <column caption='Total Sales for Parameter' datatype='real' name='[Calculation_1136090161188881]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;All&apos; &#13;&#10;THEN &#13;&#10;    // Combines ALL data into a single corporate-wide value&#13;&#10;    { FIXED : SUM([Calculation_2797999449751557]) }&#13;&#10;ELSE &#13;&#10;    // Logic for single selection: Selected team minus everything else&#13;&#10;    { FIXED : SUM(IF [SalesTeam] = [Parameters].[Parameter 1] THEN [Calculation_2797999449751557] ELSE 0 END) } &#13;&#10;    - &#13;&#10;    { FIXED : SUM(IF [SalesTeam] &lt;&gt; [Parameters].[Parameter 1] THEN [Calculation_2797999449751557] ELSE 0 END) }&#13;&#10;END' />
        </column>
        <column caption='Total Sales' datatype='real' name='[Calculation_2797999449751557]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[UnitPrice]*[OrderQuantity]' />
        </column>
        <column caption='Yearly Sales Goal' datatype='integer' name='[YearlySalesGoal]' role='measure' type='quantitative' />
        <column-instance column='[Calculation_1136090115338253]' derivation='Sum' name='[cum:sum:Calculation_1136090115338253:qk:2]' pivot='key' type='quantitative'>
          <table-calc aggregation='Sum' ordering-type='RowInPane' type='CumTotal' />
        </column-instance>
        <column-instance column='[Calculation_2797999449751557]' derivation='Sum' name='[cum:sum:Calculation_2797999449751557:qk:2]' pivot='key' type='quantitative'>
          <table-calc aggregation='Sum' ordering-type='RowInPane' type='CumTotal' />
        </column-instance>
        <column-instance column='[Calculation_1136090115338253]' derivation='Sum' name='[sum:Calculation_1136090115338253:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Calculation_1136090161188881]' derivation='Sum' name='[sum:Calculation_1136090161188881:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Calculation_2797999449751557]' derivation='Sum' name='[sum:Calculation_2797999449751557:qk]' pivot='key' type='quantitative' />
